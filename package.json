{
  "name": "rune-studio",
  "version": "0.0.25",
  "private": true,
  "description": "Voice and text driven desktop agent that controls the PC through rune-infer",
  "license": "MIT",
  "author": "Shirsendu Bairagi <shirsendu2001@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shba007/rune-studio.git"
  },
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "dev": "vp dev",
    "detect": "gitleaks git --verbose",
    "lint": "vp lint . --fix",
    "format": "vp fmt src/",
    "test:unit": "vp test",
    "test:m15": "node --test \"scripts/m15/test/*.test.mjs\"",
    "test:eval": "node --test \"scripts/eval/test/*.test.mjs\"",
    "build": "vp build",
    "preview": "vp preview",
    "clean": "(cd src-tauri && cargo clean)",
    "tauri": "tauri",
    "tauri:dev": "cargo build --manifest-path src-tauri/Cargo.toml --bin rune-studio-cli --features agent-bridge && tauri dev -- --features agent-bridge",
    "tauri:build": "tauri build",
    "tauri:dev:mobile": "tauri android dev",
    "tauri:build:mobile": "tauri android build"
  },
  "dependencies": {
    "@dotenvx/dotenvx": "^2.38.0",
    "@fontsource-variable/oxanium": "^5.3.0",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-process": "~2.4.0",
    "@tauri-apps/plugin-updater": "~2.14.0",
    "@videojs/html": "10.0.1",
    "@vueuse/core": "^15.0.0",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@iconify-json/ph": "^1.2.2",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.12.3",
    "@tsconfig/node24": "^24.0.5",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4.3.3",
    "typescript": "6.0.3",
    "unplugin-fonts": "^2.0.0",
    "unplugin-icons": "^24.0.0",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.1.0",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vite-plus": "1.1.0",
    "vue-tsc": "^3.3.13"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.1.0"
  },
  "engines": {
    "bun": "^1.2.9",
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0",
    "pnpm": "^9.15.0 || ^10.2.0 || ^11.0.0"
  },
  "packageManager": "bun@1.4.3"
}